generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum StatusPendencia {
  PENDENTE
  AGUARDANDO_CLIENTE
  EM_ATENDIMENTO
  CONCLUIDO
}

enum FrequenciaAcesso {
  NAO_DEFINIDA
  MENSAL
  EVENTUAL
}

enum TipoHistoricoPendencia {
  CRIACAO
  STATUS
  RESPONSAVEL
  OBSERVACAO
  MENSAGEM_CONTADOR
}

model Contabilidade {
  id       Int       @id @default(autoincrement())
  nome     String
  clientes Cliente[]

  criadoEm DateTime @default(now())
}

model Cliente {
  id              Int            @id @default(autoincrement())
  nome            String
  ativo           Boolean        @default(true)

  contabilidadeId Int?
  contabilidade   Contabilidade? @relation(fields: [contabilidadeId], references: [id])

  pendencias                Pendencia[]
  frequenciaAcesso          FrequenciaAcesso @default(NAO_DEFINIDA)
  observacoesPermanentes    String?           @db.Text
  modeloMensagem            String?           @db.Text
  nomesAlternativos         ClienteNomeAlternativo[]
  procedimentos             ProcedimentoCliente[]
  historicoContabilidades   HistoricoContabilidadeCliente[]

  criadoEm        DateTime       @default(now())
}

model ClienteNomeAlternativo {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  criadoEm  DateTime @default(now())

  @@unique([clienteId, nome])
}

model ProcedimentoCliente {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  titulo      String
  descricao   String   @db.Text
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, ativo])
}

model HistoricoContabilidadeCliente {
  id             Int      @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nomeAnterior   String?
  nomeNova       String?
  autor          String?
  criadoEm       DateTime @default(now())

  @@index([clienteId, criadoEm])
}

model Pendencia {
  id               Int                  @id @default(autoincrement())

  clienteId        Int
  cliente          Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  competencia      String
  status           StatusPendencia      @default(PENDENTE)

  responsavel      String?
  observacao       String?
  mensagemContador String?

  historico        HistoricoPendencia[]

  criadoEm         DateTime             @default(now())
  atualizadoEm     DateTime             @updatedAt
  concluidoEm      DateTime?

  @@unique([clienteId, competencia])
}

model HistoricoPendencia {
  id            Int                    @id @default(autoincrement())

  pendenciaId   Int
  pendencia     Pendencia              @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)

  tipo          TipoHistoricoPendencia
  valorAnterior String?
  valorNovo     String?
  autor         String?

  criadoEm      DateTime               @default(now())

  @@index([pendenciaId, criadoEm])
}
